# Copia questo file in .env e modifica i valori prima di avviare in produzione

# Chiave segreta JWT — genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key

# Algoritmo JWT
ALGORITHM=HS256

# Durata token di login in minuti.
#   0  = il token NON scade (default del codice; scelta per strumento interno).
#   >0 = scadenza attiva (es. 1440 = 24h). Impostare >0 per un deploy pubblico.
# NB: il default del codice è 0. Qui lasciamo 0 per coerenza; scommenta/cambia
# solo se vuoi la scadenza.
ACCESS_TOKEN_EXPIRE_MINUTES=0

# Origini CORS consentite (separare con virgola se multiple)
# Sviluppo locale:
ALLOWED_ORIGINS=http://localhost:5173
# Produzione (esempio):
# ALLOWED_ORIGINS=https://mechquote.dallaviafratelli.it

# URL database (default SQLite locale)
DATABASE_URL=sqlite:///./mechquote.db
