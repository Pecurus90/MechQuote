# Copia questo file in .env e modifica i valori prima di avviare in produzione

# Chiave segreta JWT — genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key

# Algoritmo JWT
ALGORITHM=HS256

# Durata token in minuti (default 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origini CORS consentite (separare con virgola se multiple)
# Sviluppo locale:
ALLOWED_ORIGINS=http://localhost:5173
# Produzione (esempio):
# ALLOWED_ORIGINS=https://mechquote.dallaviafratelli.it

# URL database (default SQLite locale)
DATABASE_URL=sqlite:///./mechquote.db
