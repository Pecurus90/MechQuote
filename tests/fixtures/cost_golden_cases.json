      "expected_quote_total": 123.50
    },
    {
      "id": "M16-round-tie",
      "name": "Tie di arrotondamento .xx5 sul totale preventivo: half-up (0.625 → 0.63, NON 0.62 banker's). Blinda parità round2 BE↔FE (M-2 audit 2026-07-20).",
      "input": {
        "quote_type": "single",
        "parts_total_price_sum": 0.625,
        "transport_cost": 0, "packaging_cost": 0, "global_discount_percent": 0
      },
      "expected_quote_total": 0.63
    }
  ],

