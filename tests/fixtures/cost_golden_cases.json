{
  "_meta": {
    "description": "Casi d'oro del cost engine. Backend (pytest) e frontend (vitest) caricano questo file e verificano che la propria implementazione produca i valori 'expected'. Convenzione: gli 'expected' sono i valori CORRETTI dopo le correzioni della Fascia 1. I casi che intercettano un bug non ancora corretto sono marcati con 'expected_today' (valore prodotto oggi) e 'fails_until' (riferimento alla correzione).",
    "tolerance_eur": 0.01,
    "tolerance_hours": 0.001,
    "shared_constants": {
      "scrap_default_percent": 10,
      "milling_h_per_dm2_default": 0.15,
      "grinding_h_per_dm2_default": 0.10,
      "drilling_h_per_dm2_default": 0.20,
      "edm_extractor_factor_default": 0.6,
      "edm_punch_factor_default": 0.3,
      "design_h_per_bend_default": 0.4,
      "design_h_per_punch_default": 0.3,
      "complexity_factor_default": 1.2,
      "plate_role_defaults": {
        "cappello":      [0.3, 1, 0, 1, 0.0],
        "porta_punzoni": [0.5, 2, 1, 2, 0.4],
        "premilamiera":  [0.4, 2, 1, 1, 0.0],
        "matrice":       [0.5, 2, 2, 2, 0.5],
        "base":          [0.3, 1, 0, 1, 0.0]
      }
    }
  },

