{
  "_meta": {
    "description": "Casi d'oro del cost engine. Backend (pytest) e frontend (vitest) caricano questo file e verificano che la propria implementazione produca i valori 'expected'. Convenzione: gli 'expected' sono i valori CORRETTI dopo le correzioni della Fascia 1. I casi che intercettano un bug non ancora corretto sono marcati con 'expected_today' (valore prodotto oggi) e 'fails_until' (riferimento alla correzione).",
    "tolerance_eur": 0.01,
    "tolerance_hours": 0.001,
    "shared_constants": {
      "scrap_default_percent": 10
    }
  },

  "calc_phase": [
    {
      "id": "M1",
      "name": "Sanity: setup 0.5h × 50€ amortizzato qty 10 + cycle 0.25h × 50€",
      "input": {
        "setup_hours": 0.5, "cycle_hours_per_part": 0.25,
        "fixed_cost": 0, "variable_cost_per_part": 0,
        "qty": 10, "work_rate": 50, "setup_rate": 50
      },
      "expected_calculated_cost": 15.0
    },
    {
      "id": "M1b",
      "name": "Phase con setup_rate distinto (Sprint 12 rate split)",
      "input": {
        "setup_hours": 1.0, "cycle_hours_per_part": 0.5,
        "fixed_cost": 100, "variable_cost_per_part": 2,
        "qty": 10, "work_rate": 60, "setup_rate": 40
      },
      "expected_calculated_cost": 46.0
    }
  ],

  "calc_material_cost_prismatic": [
    {
      "id": "M3",
      "name": "Pezzo prismatico 50×50×100mm, acciaio 7.85, 3 €/kg, scrap 10%",
      "input": {
        "raw_x_mm": 50, "raw_y_mm": 50, "raw_z_mm": 100,
        "density_kg_dm3": 7.85, "cost_per_kg": 3.0, "scrap_percent": 10
      },
      "expected_material_cost": 6.48
    },
    {
      "id": "M3b-fallback-zero",
      "name": "Densità null → fallback 0 (B2-#3 chiuso)",
      "input": {
        "raw_x_mm": 50, "raw_y_mm": 50, "raw_z_mm": 100,
        "density_kg_dm3": null, "cost_per_kg": 3.0, "scrap_percent": 10
      },
      "expected_material_cost": 0.0
    }
  ],

  "calc_material_cost_round": [
    {
      "id": "M4",
      "name": "Pezzo tondo Ø50 × 100mm, acciaio 7.85, 3 €/kg, scrap 10%",
      "input": {
        "raw_diameter_mm": 50, "raw_z_mm": 100,
        "density_kg_dm3": 7.85, "cost_per_kg": 3.0, "scrap_percent": 10
      },
      "expected_material_cost": 5.09
    }
  ],

  "calc_part_totals": [
    {
      "id": "M2",
      "name": "C4 RISOLTO: costo 0.985, qty 100, margine 0% → 98.50€ (niente doppio round)",
      "input": {
        "material_cost": 0.985, "delivery_per_piece": 0, "cutting_per_piece": 0,
        "phase_total": 0, "quantity": 100, "margin_percent": 0, "minimum_price": 0
      },
      "expected_total_price": 98.50,
      "expected_unit_price": 0.985
    },
    {
      "id": "M12",
      "name": "Prezzo minimo vince su total_cost (M12)",
      "input": {
        "material_cost": 0, "delivery_per_piece": 0, "cutting_per_piece": 0,
        "phase_total": 5.0, "quantity": 1, "margin_percent": 20, "minimum_price": 10.0
      },
      "expected_total_price": 12.00
    },
    {
      "id": "M13a",
      "name": "Margine 0% → unit_price = total_cost",
      "input": {
        "material_cost": 10, "delivery_per_piece": 0, "cutting_per_piece": 0,
        "phase_total": 0, "quantity": 1, "margin_percent": 0, "minimum_price": 0
      },
      "expected_total_price": 10.00
    },
    {
      "id": "M13b",
      "name": "Margine 500% → unit_price = total_cost × 6",
      "input": {
        "material_cost": 10, "delivery_per_piece": 0, "cutting_per_piece": 0,
        "phase_total": 0, "quantity": 1, "margin_percent": 500, "minimum_price": 0
      },
      "expected_total_price": 60.00
    },
    {
      "id": "M11",
      "name": "Conto lavoro (customer_supplied_material) → tutti i costi 0",
      "input": {
        "material_cost": 0, "delivery_per_piece": 0, "cutting_per_piece": 0,
        "phase_total": 0, "quantity": 5, "margin_percent": 20, "minimum_price": 0
      },
      "expected_total_price": 0.0
    },
    {
      "id": "M15-round-tie",
      "name": "Tie di arrotondamento .xx5: total_price half-up (0.625 → 0.63, NON 0.62 banker's). Blinda parità round2 BE↔FE (M-2 audit 2026-07-20).",
      "input": {
        "material_cost": 0.625, "delivery_per_piece": 0, "cutting_per_piece": 0,
        "phase_total": 0, "quantity": 1, "margin_percent": 0, "minimum_price": 0
      },
      "expected_total_price": 0.63,
      "expected_unit_price": 0.625
    }
  ],

  "calc_quote_total_standard": [
    {
      "id": "M14",
      "name": "1 parte 100€ + trasporto 20 + imballaggio 10 - sconto 5%",
      "input": {
